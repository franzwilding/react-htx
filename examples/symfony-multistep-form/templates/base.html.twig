<!DOCTYPE html>
<html lang="en" class="h-full bg-background text-foreground antialiased">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{% block title %}Application{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/shadcn.css') }}" />
        {% endblock %}
    </head>
    <body class="min-h-full bg-background text-foreground">
        <main class="mx-auto max-w-2xl px-4 py-12">
            <header class="mb-10">
                <h1 class="text-3xl font-semibold tracking-tight">{% block heading %}Application{% endblock %}</h1>
                <p class="mt-2 text-sm text-muted-foreground">{% block subheading %}{% endblock %}</p>
            </header>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
