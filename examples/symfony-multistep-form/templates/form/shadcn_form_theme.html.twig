{#
  reactolith + shadcn/ui form theme for Symfony Forms.
  =====================================================

  Instead of rendering plain HTML (`<input>`, `<label>`, `<select>`, …), this
  theme emits *kebab-case custom tags* which reactolith resolves to React
  components on the client. The components live under `assets/components/`
  and follow shadcn/ui's composition: `<ui-field>` wraps label / control /
  description / error, `<ui-input>` is the styled input, `<ui-button>` is
  the styled button, and so on.

  The contract is:

  - Every row renders as `<ui-field name="…">` so the field can read its
    own errors via `useFormErrors(name)` from the surrounding `<my-form>`.
  - The root form renders as `<my-form action="…" method="…"
    json-errors='[…]'>`. The error payload is a flat list of
    `{name, id, message}` so any nested field can look itself up.
  - Boolean attributes (`checked`, `selected`) are rendered as
    `json-checked='true'` / `json-value='"de"'`, because reactolith
    interprets `checked="true"` as the literal string `"true"` (see
    https://reactolith.github.io/forms/ for the full table).
  - Buttons that participate in the FormFlow navigator carry a
    `data-action` attribute so the `<flow-navigator>` component knows
    whether to put them on the back or the forward side.

  Views call only `{{ form(form) }}` — every visual + behavioural choice
  lives here.
#}

{# ---------------------------------------------------------------------------
   Row wrapper (FormItem). Becomes `<ui-field>`, which is responsible for
   the shadcn label/control/description/message stack.
   --------------------------------------------------------------------------- #}

{%- block form_row -%}
    {%- set row_attrs = {
        name: full_name,
        class: (row_attr.class|default('')),
    } -%}
    <ui-field {{ block('react_attributes')|raw }}>
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        <ui-field-error name="{{ full_name }}"></ui-field-error>
    </ui-field>
{%- endblock form_row -%}

{%- block button_row -%}
    {{- form_widget(form) -}}
{%- endblock button_row -%}

{%- block hidden_row -%}
    {{- form_widget(form) -}}
{%- endblock hidden_row -%}

{# ---------------------------------------------------------------------------
   Label / description. Both render as their own kebab-case tags so a
   custom React component can swap them out without touching the theme.
   --------------------------------------------------------------------------- #}

{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- set _label = label is empty ? name|humanize : label -%}
        <ui-field-label html-for="{{ id }}"{% if required %} required{% endif %}>{{- _label -}}</ui-field-label>
    {%- endif -%}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- if help -%}
        <ui-field-description id="{{ id }}_help">{{- help -}}</ui-field-description>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}{# inline errors are rendered by <ui-field-error>; this is a no-op. #}{%- endblock -%}

{# ---------------------------------------------------------------------------
   Simple inputs → <ui-input>
   --------------------------------------------------------------------------- #}

{%- block form_widget_simple -%}
    {%- set type = type|default('text') -%}
    {%- set _attrs = {
        name: full_name,
        id: id,
        type: type,
    } -%}
    {%- if value is not empty %}{% set _attrs = _attrs|merge({value: value}) %}{% endif -%}
    {%- if required %}{% set _attrs = _attrs|merge({required: 'required'}) %}{% endif -%}
    {%- if disabled %}{% set _attrs = _attrs|merge({disabled: 'disabled'}) %}{% endif -%}
    {%- for k, v in attr %}{% set _attrs = _attrs|merge({(k): v}) %}{% endfor -%}
    <ui-input{% for k, v in _attrs %} {{ k }}="{{ v }}"{% endfor %}></ui-input>
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    <ui-textarea name="{{ full_name }}" id="{{ id }}"{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if value is not empty %} value="{{ value }}"{% endif %}{% for k, v in attr %} {{ k }}="{{ v }}"{% endfor %}></ui-textarea>
{%- endblock textarea_widget -%}

{# ---------------------------------------------------------------------------
   Choice widgets: collapsed (<ui-select>), expanded radio (<ui-radio-group>),
   expanded multi-checkbox (<ui-checkbox-group>).
   --------------------------------------------------------------------------- #}

{%- block choice_widget -%}
    {%- if expanded -%}
        {%- if multiple -%}
            {{ block('choice_widget_expanded_multiple') }}
        {%- else -%}
            {{ block('choice_widget_expanded_single') }}
        {%- endif -%}
    {%- else -%}
        {{ block('choice_widget_collapsed') }}
    {%- endif -%}
{%- endblock choice_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set _values = data is iterable ? data : (data is null ? [] : [data]) -%}
    <ui-select name="{{ full_name }}{% if multiple %}[]{% endif %}" id="{{ id }}"{% if multiple %} multiple{% endif %}{% if disabled %} disabled{% endif %} json-value='{{ multiple ? _values|json_encode|e('html_attr') : (_values|first|default(''))|json_encode|e('html_attr') }}'{% if placeholder is not none %} placeholder="{{ placeholder|default('') }}"{% endif %}>
        {%- for choiceValue, choice in choices -%}
            {%- if choice is iterable -%}
                <optgroup label="{{ choiceValue }}">
                    {%- for c in choice -%}
                        <option value="{{ c.value }}">{{ c.label }}</option>
                    {%- endfor -%}
                </optgroup>
            {%- else -%}
                <option value="{{ choice.value }}">{{ choice.label }}</option>
            {%- endif -%}
        {%- endfor -%}
    </ui-select>
{%- endblock choice_widget_collapsed -%}

{%- block choice_widget_expanded_single -%}
    {%- set _value = data|default('') -%}
    <ui-radio-group name="{{ full_name }}" json-value='{{ _value|json_encode|e('html_attr') }}'>
        {%- for child in form -%}
            <ui-radio-group-item value="{{ child.vars.value }}" id="{{ child.vars.id }}">{{ child.vars.label }}</ui-radio-group-item>
        {%- endfor -%}
    </ui-radio-group>
{%- endblock choice_widget_expanded_single -%}

{%- block choice_widget_expanded_multiple -%}
    {%- set _values = data is iterable ? data : (data is null ? [] : [data]) -%}
    <ui-checkbox-group name="{{ full_name }}" json-value='{{ _values|json_encode|e('html_attr') }}'>
        {%- for child in form -%}
            <ui-checkbox-group-item value="{{ child.vars.value }}" id="{{ child.vars.id }}">{{ child.vars.label }}</ui-checkbox-group-item>
        {%- endfor -%}
    </ui-checkbox-group>
{%- endblock choice_widget_expanded_multiple -%}

{# ---------------------------------------------------------------------------
   Standalone checkbox row — special-cased so it gets the card layout
   (icon + label + description on the side).
   --------------------------------------------------------------------------- #}

{%- block checkbox_row -%}
    <ui-field name="{{ full_name }}">
        <div class="flex items-start gap-3 rounded-md border border-input bg-transparent p-3 shadow-sm has-[:checked]:border-primary has-[:checked]:bg-accent/40">
            {{- form_widget(form) -}}
            <div class="grid gap-1 leading-none">
                <ui-field-label html-for="{{ id }}">{{ label is empty ? name|humanize : label }}</ui-field-label>
                {%- if help -%}<ui-field-description>{{ help }}</ui-field-description>{%- endif -%}
            </div>
        </div>
        <ui-field-error name="{{ full_name }}"></ui-field-error>
    </ui-field>
{%- endblock checkbox_row -%}

{%- block radio_row -%}{{ block('checkbox_row') }}{%- endblock -%}

{%- block checkbox_widget -%}
    <ui-checkbox name="{{ full_name }}" id="{{ id }}" value="{{ value|default('1') }}"{% if checked %} json-checked="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}></ui-checkbox>
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    <ui-input type="radio" name="{{ full_name }}" id="{{ id }}" value="{{ value }}"{% if checked %} checked{% endif %}></ui-input>
{%- endblock radio_widget -%}

{# ---------------------------------------------------------------------------
   Range / Color / File / Money / Percent
   --------------------------------------------------------------------------- #}

{%- block range_widget -%}
    <ui-slider name="{{ full_name }}" id="{{ id }}"{% if value is not empty %} value="{{ value }}"{% endif %}{% for k, v in attr %} {{ k }}="{{ v }}"{% endfor %}></ui-slider>
{%- endblock range_widget -%}

{%- block color_widget -%}
    <ui-color-picker name="{{ full_name }}" id="{{ id }}"{% if value is not empty %} value="{{ value }}"{% endif %}{% if disabled %} disabled{% endif %}></ui-color>
{%- endblock color_widget -%}

{%- block file_widget -%}
    <ui-file-input name="{{ full_name }}{% if multiple|default(false) %}[]{% endif %}" id="{{ id }}"{% if multiple|default(false) %} multiple{% endif %}{% if disabled %} disabled{% endif %}{% if required %} required{% endif %}{% for k, v in attr %} {{ k }}="{{ v }}"{% endfor %}></ui-file-input>
{%- endblock file_widget -%}

{%- block money_widget -%}
    {%- set _pattern = money_pattern|default('{{ widget }}') -%}
    {%- set _prefix = _pattern|split('{{ widget }}')|first|trim -%}
    {%- set _suffix = _pattern|split('{{ widget }}')|last|trim -%}
    <ui-input
        name="{{ full_name }}"
        id="{{ id }}"
        type="text"
        {% if value is not empty %}value="{{ value }}"{% endif %}
        {% if _prefix is not empty %}data-prefix="{{ _prefix }}"{% endif %}
        {% if _suffix is not empty %}data-suffix="{{ _suffix }}"{% endif %}
    ></ui-input>
{%- endblock money_widget -%}

{%- block percent_widget -%}
    <ui-input
        name="{{ full_name }}"
        id="{{ id }}"
        type="text"
        {% if value is not empty %}value="{{ value }}"{% endif %}
        data-suffix="{{ symbol|default('%') }}"
    ></ui-input>
{%- endblock percent_widget -%}

{# ---------------------------------------------------------------------------
   Date / Time / DateTime / Week — when widget == 'single_text' they're just
   typed inputs and fall through to `form_widget_simple`. The multi-widget
   variants stay as bare selects laid out via a Tailwind flex container.
   --------------------------------------------------------------------------- #}

{%- block date_widget -%}
    {%- if widget == 'single_text' -%}{{ block('form_widget_simple') }}{%- else -%}
        <div class="flex flex-wrap items-center gap-2" id="{{ id }}">
            {{- date_pattern|replace({
                '{{ year }}': form_widget(form.year),
                '{{ month }}': form_widget(form.month),
                '{{ day }}': form_widget(form.day),
            })|raw -}}
        </div>
    {%- endif -%}
{%- endblock date_widget -%}

{%- block time_widget -%}
    {%- if widget == 'single_text' -%}{{ block('form_widget_simple') }}{%- else -%}
        <div class="flex items-center gap-2" id="{{ id }}">
            {{ form_widget(form.hour) }}{% if with_minutes %}<span class="text-muted-foreground">:</span>{{ form_widget(form.minute) }}{% endif %}{% if with_seconds %}<span class="text-muted-foreground">:</span>{{ form_widget(form.second) }}{% endif %}
        </div>
    {%- endif -%}
{%- endblock time_widget -%}

{%- block datetime_widget -%}
    {%- if widget == 'single_text' -%}{{ block('form_widget_simple') }}{%- else -%}
        <div class="flex flex-wrap items-center gap-3" id="{{ id }}">
            <div class="space-y-1">{{ form_widget(form.date) }}</div>
            <div class="space-y-1">{{ form_widget(form.time) }}</div>
        </div>
    {%- endif -%}
{%- endblock datetime_widget -%}

{%- block week_widget -%}
    {%- if widget == 'single_text' -%}{{ block('form_widget_simple') }}{%- else -%}
        <div class="flex items-center gap-2" id="{{ id }}">{{ form_widget(form.year) }}<span class="text-muted-foreground">-</span>{{ form_widget(form.week) }}</div>
    {%- endif -%}
{%- endblock week_widget -%}

{%- block dateinterval_widget -%}
    {%- if widget == 'single_text' -%}{{ block('form_widget_simple') }}{%- else -%}
        <div class="grid grid-flow-col gap-3" id="{{ id }}">
            {%- if with_years %}<div class="space-y-1"><ui-field-label>Years</ui-field-label>{{ form_widget(form.years) }}</div>{% endif -%}
            {%- if with_months %}<div class="space-y-1"><ui-field-label>Months</ui-field-label>{{ form_widget(form.months) }}</div>{% endif -%}
            {%- if with_weeks %}<div class="space-y-1"><ui-field-label>Weeks</ui-field-label>{{ form_widget(form.weeks) }}</div>{% endif -%}
            {%- if with_days %}<div class="space-y-1"><ui-field-label>Days</ui-field-label>{{ form_widget(form.days) }}</div>{% endif -%}
            {%- if with_hours %}<div class="space-y-1"><ui-field-label>Hours</ui-field-label>{{ form_widget(form.hours) }}</div>{% endif -%}
            {%- if with_minutes %}<div class="space-y-1"><ui-field-label>Minutes</ui-field-label>{{ form_widget(form.minutes) }}</div>{% endif -%}
            {%- if with_seconds %}<div class="space-y-1"><ui-field-label>Seconds</ui-field-label>{{ form_widget(form.seconds) }}</div>{% endif -%}
        </div>
    {%- endif -%}
{%- endblock dateinterval_widget -%}

{# ---------------------------------------------------------------------------
   Collection — render the prototype on the server, pass the prototype HTML
   to `<flow-collection>` so it can add new rows client-side.
   --------------------------------------------------------------------------- #}

{%- block collection_widget -%}
    {%- if prototype is defined and not prototype.rendered -%}
        {%- set _prototype = form_row(prototype) -%}
    {%- else -%}
        {%- set _prototype = '' -%}
    {%- endif -%}
    <flow-collection id="{{ id }}"{% if _prototype is not empty %} prototype="{{ _prototype|e('html_attr') }}"{% endif %} prototype-name="__name__">
        {%- for child in form -%}
            <flow-collection-row>
                {{- form_row(child) -}}
            </flow-collection-row>
        {%- endfor -%}
    </flow-collection>
{%- endblock collection_widget -%}

{# ---------------------------------------------------------------------------
   Buttons — `<ui-button>` with shadcn variants. FormFlow buttons forward
   `data-action` so `<flow-navigator>` knows where to put them.
   --------------------------------------------------------------------------- #}

{%- block button_widget -%}
    {%- set _action = attr['data-action']|default(null) -%}
    {%- if _action is null and 'previous' in (attr['class']|default('')) -%}
        {%- set _action = 'previous' -%}
    {%- endif -%}
    {%- set _variant = attr['data-variant']|default(_action == 'previous' ? 'outline' : 'default') -%}
    {%- set _label = label is same as(false) or label is empty ? name|humanize : label -%}
    <ui-button type="{{ type|default('button') }}" name="{{ full_name }}" id="{{ id }}" variant="{{ _variant }}"{% if _action %} data-action="{{ _action }}"{% endif %}{% if disabled %} disabled{% endif %}>{{- _label -}}</ui-button>
{%- endblock button_widget -%}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    {{ block('button_widget') }}
{%- endblock submit_widget -%}

{%- block reset_widget -%}
    {%- set type = type|default('reset') -%}
    {{ block('button_widget') }}
{%- endblock reset_widget -%}

{# ---------------------------------------------------------------------------
   FormFlow integration — the navigator becomes `<flow-navigator>`, which
   reads `data-action` on each button to split them into back vs forward.
   --------------------------------------------------------------------------- #}

{%- block navigator_flow_widget -%}
    <flow-navigator>
        {%- if form.previous is defined and not form.previous.rendered -%}
            {{ form_widget(form.previous, {label: 'Back', attr: {'data-action': 'previous'}}) }}
        {%- endif -%}
        {%- if form.next is defined and not form.next.rendered -%}
            {{ form_widget(form.next, {label: 'Continue', attr: {'data-action': 'next'}}) }}
        {%- endif -%}
        {%- if form.finish is defined and not form.finish.rendered -%}
            {{ form_widget(form.finish, {label: 'Submit application', attr: {'data-action': 'finish'}}) }}
        {%- endif -%}
    </flow-navigator>
{%- endblock navigator_flow_widget -%}

{%- block form_flow_widget -%}
    {%- set _errors = reactolith_form_errors(form) -%}
    <flow-progress json-steps='{{ reactolith_progress_steps(form)|json_encode|e('html_attr') }}'></flow-progress>
    {{- block('form_widget_compound') -}}
{%- endblock form_flow_widget -%}

{# ---------------------------------------------------------------------------
   Root form — `<my-form>` resolves to reactolith's `<Form>` and propagates
   `json-errors` to every nested `<ui-field>` via `useFormErrors`.
   --------------------------------------------------------------------------- #}

{%- block form_start -%}
    {%- do form.setMethodRendered() -%}
    {%- set method = method|upper -%}
    {%- set form_method = method in ['GET', 'POST'] ? method : 'POST' -%}
    {%- set _errors = reactolith_form_errors(form) -%}
    <my-form action="{{ action }}" method="{{ form_method|lower }}"{% if multipart %} enctype="multipart/form-data"{% endif %}{% if _errors|length > 0 %} json-errors='{{ _errors|json_encode|e('html_attr') }}'{% endif %}>
    {%- if form_method != method -%}
        <input type="hidden" name="_method" value="{{ method }}" />
    {%- endif -%}
{%- endblock form_start -%}

{%- block form_end -%}
    {%- if not render_rest is defined or render_rest -%}
        {{ form_rest(form) }}
    {%- endif -%}
    </my-form>
{%- endblock form_end -%}

{%- block form_widget_compound -%}
    <div class="space-y-6">
        {{- block('form_rows') -}}
        {{- form_rest(form) -}}
    </div>
{%- endblock form_widget_compound -%}

{# Common attribute-rendering helper used by every widget. #}
{%- block react_attributes -%}
    {%- for k, v in row_attrs -%}
        {%- if v is not null and v is not same as(false) -%}
            {%- if v is same as(true) %} {{ k }}{% else %} {{ k }}="{{ v }}"{% endif -%}
        {%- endif -%}
    {%- endfor -%}
{%- endblock react_attributes -%}
